# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
# Use the anon (public) key — never the service role key in NEXT_PUBLIC_* vars.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Or legacy name (either anon key var works):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Server-only: required for webhooks and Gmail token storage
SUPABASE_SERVICE_ROLE_KEY=

# Optional: direct Postgres (migrations / tooling)
DATABASE_URL=

# OpenAI (required for chat / AI features)
OPENAI_API_KEY=

# Public app base URL (used for client-side API calls)
# Dev: http://localhost:3000
# Prod: https://your-domain.com
NEXT_PUBLIC_BASE_URL=

# Google OAuth — set GOOGLE_REDIRECT_URI to your deployed origin, e.g.
# https://your-domain.com/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional: local single-user dev only — production uses per-user tokens in google_oauth_tokens
GOOGLE_REFRESH_TOKEN=

# Protect inbound webhooks (required in production if you use webhooks)
INBOUND_WEBHOOK_SECRET=
